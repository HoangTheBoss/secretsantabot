[Unit]
Description=Buda Secret Santa Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
Group={{GROUP}}
WorkingDirectory={{WORKDIR}}
ExecStart={{WORKDIR}}/.venv/bin/python3 {{WORKDIR}}/run.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

# Environment settings
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65535

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=budasecretsanta

# Security sandboxing
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths={{WORKDIR}}/data {{WORKDIR}}/assets

[Install]
WantedBy=multi-user.target
