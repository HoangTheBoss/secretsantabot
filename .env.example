# Discord Bot Authentication
DISCORD_TOKEN=your_bot_token_here

# Discord Server & Channel Binding
GUILD_ID=000000000000000000
SANTA_CHANNEL_ID=000000000000000000
SANTA_ADMIN_ROLE_ID=000000000000000000

# Timezone Setting (Defaults to Vietnam Time ICT / UTC+7)
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Routine Updates & Reminders
ROUTINE_REMINDERS_ENABLED=true
ROUTINE_REMINDER_HOURS=24

# Event Branding (Configured via ENV since bot is private)
EVENT_NAME=Buda Secret Santa 2026
THEME_COLOR=RED
FOOTER_TEXT=Buda Secret Santa • Happy Holidays! 🎄
LOGO_FILENAME=logo.png
BANNER_FILENAME=banner.png

# Built-in Asset HTTP Server & Reverse Proxy Configuration
# Place branding files (logo.png, banner.png) in the assets/ directory.
HTTP_SERVER_ENABLED=true
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Reverse Proxy Public Hostname:
# If running behind Nginx, Caddy, Cloudflare Tunnel, etc., specify your public domain:
# e.g., PUBLIC_HOSTNAME=santa.yourdomain.com  (or PUBLIC_URL=https://santa.yourdomain.com)
PUBLIC_HOSTNAME=
PUBLIC_URL=

# Storage
DATABASE_PATH=data/secretsanta.db

# App Settings
LOG_LEVEL=INFO
